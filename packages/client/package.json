{
  "name": "@gekal-study-nodejs/client",
  "version": "0.1.0",
  "description": "High-level client that composes @gekal-study-nodejs/core and @gekal-study-nodejs/utils.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gekal-study-nodejs/multi-package-poc.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@gekal-study-nodejs/core": "workspace:^",
    "@gekal-study-nodejs/utils": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
